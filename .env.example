# Copy to `.env` in the project root, then restart `npm run dev`.
# Supabase → Project Settings → API (Project URL + anon/public key)

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_anon_public_key

# Igbo API (https://igboapi.com) — dictionary search & pronunciation fallback
VITE_IGBO_API_KEY=your_igbo_api_key

# Supabase Edge Function secrets (set via `supabase secrets set`, not in Vite):
# YARNGPT_API_KEY=...         # Igbo TTS
# IGBO_API_KEY=...            # Igbo API speech-to-text (recommended for mic)
#
# LLM — auto-picks whichever key is set (see supabase/functions/_shared/llm.ts):
# ANTHROPIC_API_KEY=...       # Claude (tutor + speaking coach) — preferred if both set
# OPENAI_API_KEY=...          # OpenAI chat + Whisper ASR fallback
# LLM_API_KEY=...             # Legacy OpenAI key (ignored if it looks like sk-ant-…)
# LLM_PROVIDER=auto           # auto | anthropic | openai (optional force)
# LLM_MODEL=...               # optional override (default: Haiku or gpt-4o-mini)
