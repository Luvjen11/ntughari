# Copy to `.env` in the project root, then restart `npm run dev`.
# Supabase → Project Settings → API (Project URL + anon/public key)

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_anon_public_key

# Igbo API (https://igboapi.com) — dictionary search & pronunciation fallback
VITE_IGBO_API_KEY=your_igbo_api_key

# Supabase Edge Function secrets (set via `supabase secrets set`, not in Vite):
# YARNGPT_API_KEY=...
# LLM_API_KEY=...          # OpenAI for ai-tutor + Whisper ASR fallback
# IGBO_API_KEY=...         # Optional: Igbo API speech-to-text on asr function
